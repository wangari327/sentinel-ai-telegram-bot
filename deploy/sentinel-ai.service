[Unit]
Description=SentinelAI Telegram Anti-Spam Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sentinel
Group=sentinel
WorkingDirectory=/opt/sentinel-ai-telegram-bot
EnvironmentFile=/opt/sentinel-ai-telegram-bot/.env
ExecStart=/opt/sentinel-ai-telegram-bot/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
