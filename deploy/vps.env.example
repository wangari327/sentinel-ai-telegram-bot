# SentinelAI VPS environment file.
# Copy to /opt/sentinel-ai-telegram-bot/.env and fill the blank values.
# Never commit the real .env file or paste it into public logs.

BOT_TOKEN=

# Public HTTPS base URL for the VPS, without a trailing slash.
# Example: https://antispam.ibox-tv.com
WEBHOOK_BASE_URL=https://antispam.ibox-tv.com
WEBHOOK_SECRET=
AUTO_SET_WEBHOOK=true
TELEGRAM_WEBHOOK_MAX_CONNECTIONS=10
TELEGRAM_DROP_PENDING_UPDATES_ON_STARTUP=true
AUTO_MIGRATE=true
DEMO_MODE=false
LOG_LEVEL=INFO
RETENTION_DAYS=30
APP_HOST_PORT=127.0.0.1:8010

# Docker Compose defaults below match deploy/vps.docker-compose.yml.
DATABASE_URL=postgresql+psycopg://sentinel:CHANGE_ME_DB_PASSWORD@postgres:5432/sentinel
REDIS_URL=redis://redis:6379/0

# Authorized chats only. This bot ignores all groups outside this allowlist
# unless an OWNER_ADMIN_IDS user runs /setup.
REQUIRE_AUTHORIZED_CHATS=true
AUTHORIZED_CHAT_IDS=-1001303757981,-1002370580254
OWNER_ADMIN_IDS=762308466
DEFAULT_NOTIFY_ADMIN_ID=762308466
LEAVE_UNAUTHORIZED_CHATS=false
DEFAULT_GROUP_MODE=monitor_only

# Recommended affordable provider for your current plan.
AI_PROVIDER=hcnsec
AI_FALLBACK_PROVIDER=rules_only
AI_TIMEOUT_SECONDS=6
AI_MAX_RETRIES=2
AI_USE_STRUCTURED_OUTPUT=false
AI_ESCALATE_ON_UNSURE=true
AI_ENABLE_PROVIDER_FALLBACK=true

# hcnsec/NewAPI gateway. Fill HCNSEC_API_KEY on the VPS only.
HCNSEC_API_KEY=
HCNSEC_BASE_URL=https://api.hcnsec.cn
HCNSEC_MODEL=deepseek-v4-flash
HCNSEC_PROVIDER_NAME=hcnsec
OPENAI_COMPATIBLE_USE_STRUCTURED_OUTPUT=false

# Optional providers.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5-mini
OPENAI_ESCALATION_MODEL=gpt-5.5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional iBOX support assistant. Use a read-only DB user if possible.
SUPPORT_ENABLED=true
SUPPORT_AI_INTENT_ENABLED=true
SUPPORT_AI_INTENT_THRESHOLD=0.68
SUPPORT_AI_INTENT_MAX_TEXT_CHARS=700
PRIVATE_SUPPORT_ENABLED=true
PRIVATE_ABUSE_SILENCE_AFTER=3
SUPPORT_AI_REPLIES=true
SUPPORT_TONE=playful, lightly sarcastic, chatty, funny, helpful, and never rude
SUPPORT_REPLY_CLEANUP_SECONDS=86400
TVWEB_DATABASE_URL=
TVWEB_SITE_BASE_URL=https://ibox-tv.com
TVWEB_ANIME_BASE_URL=https://anime.ibox-tv.com
TVWEB_MOVIES_BASE_URL=https://movies.ibox-tv.com
TUTORIAL_DUMP_CHAT_ID=-1003743973576
TVWEB_CACHE_ENABLED=true
TVWEB_CACHE_REFRESH_ON_STARTUP=false
TVWEB_CACHE_REFRESH_INTERVAL_MINUTES=360
TVWEB_CACHE_REFRESH_TIMES=02:00,08:00,14:00,20:00
TVWEB_CACHE_REFRESH_LIMIT=5000

# Optional TMDB metadata for release dates and unaired season/episode checks.
# Copy TMDB_BEARER_TOKEN from the iBOX website env. Do not use TMDB_BACKFILL_TOKENS here.
TMDB_METADATA_ENABLED=true
TMDB_BEARER_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_LANGUAGE=en-US
TMDB_REGION=US
TMDB_TIMEOUT_SECONDS=5
TMDB_CACHE_TTL_SECONDS=21600

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_PROVIDER_NAME=deepseek

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct

SPAM_DELETE_THRESHOLD=0.88
SPAM_BAN_THRESHOLD=0.96
SPAM_REPEAT_BAN_AFTER=2
MODERATION_DELETE_NOTICE_ENABLED=true
MODERATION_NOTICE_CLEANUP_SECONDS=86400
SUSPICIOUS_LOW_THRESHOLD=0.55
SUSPICIOUS_HIGH_THRESHOLD=0.87
AI_SCAN_ALL_MESSAGES=false
AI_SCAN_LINKS_ONLY=true
